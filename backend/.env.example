# Copy to .env. Every value has a working local default except DATABASE_URL.
NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://azure:azure@localhost:55433/azure

# Required in production (min 32 chars): openssl rand -base64 48
JWT_SECRET=dev-only-access-secret-change-me-0123456789
CLIENT_URL=http://localhost:3000
# COOKIE_SAMESITE=lax        # use "none" (+ HTTPS) if frontend and API are on different sites
# COOKIE_SECURE=true         # defaults to true in production

# Razorpay test mode: Dashboard → Settings → API Keys (test). Leave empty to use the
# built-in test gateway, which implements the same HMAC signature scheme.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
